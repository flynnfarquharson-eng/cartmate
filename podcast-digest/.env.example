# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or share these keys.

# ── Supabase (Phase 1) ──────────────────────────────────────────
# Supabase dashboard > Project Settings > API Keys (and "Data API" for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "Publishable key" (starts with sb_publishable_). Safe to use in the browser.
# (Older projects: the "anon" key works too.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "Secret key" (starts with sb_secret_). SERVER ONLY - full database access.
# (Older projects: the "service_role" key works too.)
SUPABASE_SECRET_KEY=

# ── Podcast Index (Phase 1) ─────────────────────────────────────
# Sign up free at https://api.podcastindex.org/signup - key + secret arrive by email
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# ── App (Phase 1) ───────────────────────────────────────────────
# Your email. This account can trigger feed checks by hand, and gets the admin page later.
ADMIN_EMAIL=you@example.com
# Any long random string. Vercel's cron sends it so strangers can't run your jobs.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── AI pipeline (Phase 2 - leave blank for now) ─────────────────
# https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# https://console.deepgram.com > API Keys
DEEPGRAM_API_KEY=
